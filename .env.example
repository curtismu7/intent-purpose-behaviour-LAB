# Optional. The shared settings file is ~/Development/.env (or the path in STANDALONE_ENV); this file only shows this app's keys.
# Everything has a safe default; the demo needs no tenant and no credentials. No PORT lives in the shared file.
# PORT must be in 7100-7149.
PORT=7100
# IPB_LAB_MODE=mock       # the mode the page opens in: mock or live (both loopback-only, no outbound network)
# IPBLAB_BIND=127.0.0.1   # loopback only unless you set this on purpose
